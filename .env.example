# Copy to .env.local and fill in. Vite only exposes variables prefixed VITE_.

# Base URL of the OTCI backend, no trailing slash. Example: https://api.otci.lagosstate.gov.ng
VITE_API_BASE_URL=http://localhost:8000

# Prefix for the /admin/submissions routes. All admin routes including submissions
# are now under /api/v1 (updated 9 Nov 2026 Postman collection).
VITE_API_SUBMISSIONS_PREFIX=/api/v1
