# Copy to .env.local and fill in. Vite only exposes variables prefixed VITE_.

# Base URL of the OTCI backend, no trailing slash. Example: https://api.otci.lagosstate.gov.ng
VITE_API_BASE_URL=http://localhost:8000

# Prefix for the /admin/submissions routes. The Postman collection writes them
# without /api/v1 while every other route has it. Leave empty to follow the
# collection; set to /api/v1 if the backend actually serves them there.
VITE_API_SUBMISSIONS_PREFIX=
